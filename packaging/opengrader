#!/bin/sh

set -u

MARKER_FILE="pyproject.toml"
MARKER_LINE='^name = "opengrader"$'

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/opengrader"
CACHE_FILE="$CACHE_DIR/checkout-path"

MAX_DEPTH=5

debug() {
    [ -n "${OPENGRADER_WRAPPER_DEBUG:-}" ] || return 0
    printf 'opengrader[wrapper]: %s\n' "$1" >&2
}

die() {
    printf 'opengrader: %s\n' "$1" >&2
    exit 1
}

is_checkout() {
    [ -n "${1:-}" ] || return 1
    [ -f "$1/$MARKER_FILE" ] || return 1
    grep -q "$MARKER_LINE" "$1/$MARKER_FILE" 2>/dev/null
}

walk_up_from() {
    dir=$1
    while :; do
        if is_checkout "$dir"; then
            printf '%s\n' "$dir"
            return 0
        fi
        parent=$(dirname "$dir")
        [ "$parent" = "$dir" ] && return 1
        dir=$parent
    done
}

search_for_checkout() {
    if [ -n "${OPENGRADER_SEARCH_ROOTS:-}" ]; then
        old_ifs=$IFS
        IFS=':'
        set -- $OPENGRADER_SEARCH_ROOTS
        IFS=$old_ifs
        for root in "$@"; do
            [ -d "$root" ] || continue
            if found=$(search_one_root "$root"); then
                printf '%s\n' "$found"
                return 0
            fi
        done
        return 1
    fi

    for volume in /Volumes/*; do
        [ -L "$volume" ] && continue
        [ -d "$volume" ] || continue
        if found=$(search_one_root "$volume"); then
            printf '%s\n' "$found"
            return 0
        fi
    done
    if [ -d "$HOME" ] && found=$(search_one_root "$HOME"); then
        printf '%s\n' "$found"
        return 0
    fi
    return 1
}

search_one_root() {
    matches=$(
        find "$1" -maxdepth "$MAX_DEPTH" \
            \( -name .venv -o -name node_modules -o -name .git \
               -o -name .Trash -o -name Library \) -prune -o \
            -name "$MARKER_FILE" -print 2>/dev/null
    )
    [ -n "$matches" ] || return 1

    found=''
    others=''
    old_ifs=$IFS
    IFS='
'
    for candidate in $matches; do
        dir=$(dirname "$candidate")
        if is_checkout "$dir"; then
            if [ -z "$found" ]; then
                found=$dir
            else
                others="$others
  $dir"
            fi
        fi
    done
    IFS=$old_ifs

    [ -n "$found" ] || return 1
    if [ -n "$others" ]; then
        printf 'opengrader: found more than one checkout under %s; using %s\n' "$1" "$found" >&2
        printf 'opengrader: also found:%s\n' "$others" >&2
        printf 'opengrader: set OPENGRADER_HOME to choose a different one.\n' >&2
    fi
    printf '%s\n' "$found"
}

remember() {
    mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
    printf '%s\n' "$1" >"$CACHE_FILE" 2>/dev/null || return 0
}

resolve_checkout() {
    if [ -n "${OPENGRADER_HOME:-}" ]; then
        if is_checkout "$OPENGRADER_HOME"; then
            debug "using \$OPENGRADER_HOME"
            printf '%s\n' "$OPENGRADER_HOME"
            return 0
        fi
        printf 'opengrader: %s\n' "\$OPENGRADER_HOME is set to '$OPENGRADER_HOME', which is not an Opengrader checkout.
  A checkout is the directory holding $MARKER_FILE and src/opengrader/.
  Unset it to let opengrader find the checkout itself." >&2
        return 2
    fi

    script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || script_dir=''
    if [ -n "$script_dir" ]; then
        in_place=$(dirname "$script_dir")
        if is_checkout "$in_place"; then
            debug "using the checkout this script lives in"
            printf '%s\n' "$in_place"
            return 0
        fi
    fi

    here=$(pwd -P 2>/dev/null) || here=''
    if [ -n "$here" ] && found=$(walk_up_from "$here"); then
        debug "using the checkout containing the current directory"
        remember "$found"
        printf '%s\n' "$found"
        return 0
    fi

    if [ -f "$CACHE_FILE" ]; then
        cached=$(cat "$CACHE_FILE" 2>/dev/null) || cached=''
        if is_checkout "$cached"; then
            debug "using the remembered path ($CACHE_FILE)"
            printf '%s\n' "$cached"
            return 0
        fi
        debug "remembered path is stale, searching"
        rm -f "$CACHE_FILE" 2>/dev/null
    fi

    debug "searching /Volumes/* and \$HOME (depth $MAX_DEPTH)"
    if found=$(search_for_checkout); then
        debug "found $found"
        remember "$found"
        printf '%s\n' "$found"
        return 0
    fi

    return 1
}


project=$(resolve_checkout)
resolve_status=$?
[ "$resolve_status" -eq 2 ] && exit 1
if [ "$resolve_status" -ne 0 ] || [ -z "$project" ]; then
    if [ -n "${OPENGRADER_SEARCH_ROOTS:-}" ]; then
        searched="\$OPENGRADER_SEARCH_ROOTS ($OPENGRADER_SEARCH_ROOTS)"
    else
        searched="every mounted volume in /Volumes, and $HOME"
    fi
    die "could not find an Opengrader checkout.
  Looked under $searched.
  If the project is on an external drive, check that it is plugged in and mounted.
  Otherwise point at it directly:  export OPENGRADER_HOME=/path/to/the/checkout"
fi


python_can_import() {
    [ -n "${1:-}" ] || return 1
    [ -x "$1" ] || return 1
    "$1" -c 'import opengrader' >/dev/null 2>&1
}

venv_has_package() {
    [ -e "$1/bin/opengrader" ] && return 0
    for marker in \
        "$1"/lib/python*/site-packages/opengrader \
        "$1"/lib/python*/site-packages/opengrader-*.dist-info \
        "$1"/lib/python*/site-packages/*editable*opengrader*.pth
    do
        [ -e "$marker" ] && return 0
    done
    return 1
}

find_project_venv() {
    for name in .venv venv env; do
        candidate="$project/$name"
        if [ -x "$candidate/bin/python" ] && venv_has_package "$candidate"; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

venv_is_uv_made() {
    [ -f "$1/pyvenv.cfg" ] || return 1
    grep -q '^uv = ' "$1/pyvenv.cfg" 2>/dev/null
}

project_venv=$(find_project_venv) || project_venv=''

if [ -n "${OPENGRADER_PYTHON:-}" ]; then
    if ! python_can_import "$OPENGRADER_PYTHON"; then
        die "\$OPENGRADER_PYTHON is set to '$OPENGRADER_PYTHON', which cannot import opengrader.
  It must be a Python 3.12 interpreter with the project installed into it."
    fi
    debug "running with \$OPENGRADER_PYTHON"
    exec "$OPENGRADER_PYTHON" -m opengrader "$@"
fi

if [ -n "$project_venv" ] && ! venv_is_uv_made "$project_venv"; then
    debug "running with $project_venv (not uv-made; uv left alone)"
    exec "$project_venv/bin/python" -m opengrader "$@"
fi

if command -v uv >/dev/null 2>&1; then
    debug "running with uv"
    exec uv run --project "$project" opengrader "$@"
fi

if [ -n "$project_venv" ]; then
    debug "running with $project_venv (uv not installed)"
    exec "$project_venv/bin/python" -m opengrader "$@"
fi

if command -v poetry >/dev/null 2>&1; then
    poetry_env=$(cd "$project" 2>/dev/null && poetry env info --path 2>/dev/null) || poetry_env=''
    if [ -n "$poetry_env" ] && python_can_import "$poetry_env/bin/python"; then
        debug "running with poetry's environment ($poetry_env)"
        exec "$poetry_env/bin/python" -m opengrader "$@"
    fi
fi

for activated in "${VIRTUAL_ENV:-}" "${CONDA_PREFIX:-}"; do
    if [ -n "$activated" ] && python_can_import "$activated/bin/python"; then
        debug "running with the activated environment ($activated)"
        exec "$activated/bin/python" -m opengrader "$@"
    fi
done

for name in python3 python; do
    candidate=$(command -v "$name" 2>/dev/null) || continue
    if python_can_import "$candidate"; then
        debug "running with $candidate (already has opengrader installed)"
        exec "$candidate" -m opengrader "$@"
    fi
done

die "found the project at $project, but no Python environment that can run it.
  The project needs Python 3.12 and its dependencies. Set one up with whichever
  tool you use, from that directory:

    uv sync                                  (what this project is developed with)
    poetry install
    python3.12 -m venv .venv && .venv/bin/pip install -e .

  Or point at an interpreter that already has it:
    export OPENGRADER_PYTHON=/path/to/python"
