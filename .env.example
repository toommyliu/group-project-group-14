# Copy to .env in the directory where you run `opengrader serve`.
# Shell variables take precedence. Restart the server after changing .env.

# Server log level: debug, info, warning, or error, in any case.
# The server writes JSON lines to <workspace>/.opengrader/logs/server.jsonl.
OPENGRADER_LOG_LEVEL=info

# Local grading hides sign-in and refuses remote access by default.
OPENGRADER_AUTH_ENABLED=false

# Required when OPENGRADER_AUTH_ENABLED=true.
OPENGRADER_GOOGLE_CLIENT_ID=
OPENGRADER_GOOGLE_CLIENT_SECRET=
# Generate a session secret: openssl rand -hex 48 | pbcopy
OPENGRADER_SESSION_SECRET=

OPENGRADER_GOOGLE_DOMAIN=sjsu.edu

# CSV of emails
OPENGRADER_INSTRUCTORS=

# Use secure cookies for HTTPS hosting through Tailscale or another local proxy.
OPENGRADER_SECURE_COOKIE=true
