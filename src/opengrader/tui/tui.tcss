# https://textual.textualize.io/guide/design/#base-colors
$accent: #81A1C1;
$background: #181818;
$foreground: #E4E4E4EB;

#qa-picker-title {
    margin: 1 1 0 1;
    text-style: bold;
}

#qa-picker-subtitle {
    margin: 0 1 1 1;
    color: $text-muted;
}

#qa-picker-workspace {
    height: 1fr;
}

#qa-picker-left-column {
    width: 42;
    height: 1fr;
}

#qa-list {
    border: round $surface-lighten-2;
    border-title-align: left;
    border-title-color: $text-muted;
    width: 100%;
    height: 1fr;
    background: transparent;
}

#qa-list.-pane-active {
    border-title-color: $accent;
    border: round $accent;
    text-style: bold;
}

#student-list {
    border: round $surface-lighten-2;
    border-title-align: left;
    border-title-color: $text-muted;
    width: 100%;
    height: 1fr;
    margin-top: 1;
    background: transparent;
}

#student-list.-pane-active {
    border-title-color: $accent;
    border: round $accent;
    text-style: bold;
}

#qa-list > ListItem,
#student-list > ListItem {
    background: transparent;
    color: $foreground;
}

#qa-list > ListItem.-highlight,
#student-list > ListItem.-highlight {
    background: #202326;
    color: $foreground;
    text-style: none;
}

#qa-list.-pane-active > ListItem.-highlight,
#student-list.-pane-active > ListItem.-highlight {
    background: #344352;
    color: $foreground;
    text-style: bold;
}

#qa-details {
    border: round $surface-lighten-1;
    margin-left: 1;
    padding: 1;
    width: 1fr;
    height: 1fr;
    background: transparent;
}

#qa-keybinding-ref {
    dock: bottom;
    color: $text-muted;
}

#qa-status {
    background: transparent;
    color: $foreground;
    padding: 0 1;
    height: 1;
}
