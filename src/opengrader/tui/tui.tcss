# https://textual.textualize.io/guide/design/#base-colors
$accent: #81A1C1;
$background: #181818;
$foreground: #E4E4E4EB;

/* --- Course Picker Screen --- */

#course-picker-title {
    margin: 1 1 0 1;
    text-style: bold;
}

#course-picker-subtitle {
    margin: 0 1 1 1;
    color: $text-muted;
}

#course-picker-workspace {
    height: 1fr;
}

/* --- The Main Container (CoursePane) --- */

#course-picker-pane {
    border: round $accent;
    border-title-align: left;
    border-subtitle-align: right;
    border-title-color: $foreground;
    border-subtitle-color: $text-muted;
    background: $background;
    height: 1fr;
}

#course-picker-pane:focus-within {
    border-title-color: $accent;
}

/* --- List View & Scrolling Logic --- */

#course-picker-pane IndexedListView {
    width: 1fr;
    height: 1fr;
    overflow-x: scroll;

    /* Reserves space for the scrollbar so it doesn't overlap content */
    scrollbar-gutter: stable; 
}

/* Force text to stay on one line to trigger horizontal scroll */
#course-picker-pane _NavListItem Label {
    width: auto;
    text-wrap: nowrap; 
}

#course-picker-pane _NavListItem {
    width: auto;
    min-width: 100%;
}

/* --- Scrollbar Styling (Fixes the 'Black Out') --- */

#course-picker-pane IndexedListView > .scrollbar--horizontal {
    /* Using $surface-lighten-1 or a specific color prevents the black-on-black look */
    background: $surface;
    color: $accent;
    height: 1;
}

/* --- Sidebar & Details --- */

#course-picker-sidebar {
    width: 40; /* Slightly wider to accommodate borders */
    overflow: hidden;
}

#course-picker-details {
    margin-left: 1;
    width: 1fr;
}

#course-picker-status {
    background: $accent;
    color: $foreground;
    padding: 0 1;
    height: 1;
}

/* --- Home Screen Layout --- */

#home-workspace {
    height: 1fr;
}

#home-selection-details {
    margin-left: 1;
}

/* --- Utility Classes --- */

.student-sub-item {
    color: $text-muted;
}