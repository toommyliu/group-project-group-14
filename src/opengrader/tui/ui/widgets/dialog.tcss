Dialog, AlertDialog {
    align: center middle;
}

#dialog-panel {
    width: 58;
    min-width: 46;
    max-width: 88%;
    height: auto;
    max-height: 75%;
    padding: 0 1;
    background: $background;
    border: round $accent;
    border-title-color: $foreground;
    border-title-align: left;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
}

.dialog-field-row {
    height: auto;
    margin-top: 1;
    align-vertical: middle;
}

.dialog-field-label {
    width: 18;
    min-width: 14;
    color: $text-muted;
}

# TODO: figure out how to get this to work
# it shrinks the height but the text does not render in its viewport
.dialog-field-input {
    width: 1fr;
    # height: 1;
    # min-height: 1;
}

#dialog-error {
    margin-top: 1;
    color: $error;
    min-height: 1;
}

#dialog-actions {
    align-horizontal: right;
    height: auto;
}

.dialog-action {
    color: $text-muted;
    border: round transparent;
}

.dialog-action:hover,
.dialog-action:focus {
    color: $foreground;
    border: round $accent;
}

.dialog-alert-message {
    padding-top: 1;
    color: $foreground;
    height: auto;
    width: 100%;
    content-align: center middle;
}