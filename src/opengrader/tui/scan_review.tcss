#scan-review-screen {
    height: 1fr;
    background: $background;
}

#scan-review-title {
    margin: 1 1 0 1;
    text-style: bold;
}

#scan-review-summary {
    margin: 0 1 1 1;
    color: $text-muted;
}

#scan-review-workspace {
    height: 1fr;
}

#scan-review-left-column {
    width: 52;
    height: 1fr;
}

#scan-review-list {
    border: round $surface-lighten-2;
    border-title-align: left;
    border-title-color: $accent;
    width: 100%;
    height: 1fr;
    background: transparent;
}

#scan-review-list > ListItem {
    background: transparent;
    color: $foreground;
}

#scan-review-list > ListItem.-highlight {
    background: #344352;
    color: $foreground;
    text-style: bold;
}

#scan-review-details {
    border: round $surface-lighten-1;
    margin-left: 1;
    padding: 1;
    width: 1fr;
    height: 1fr;
    background: transparent;
}

#scan-review-info {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#scan-review-pages {
    width: 100%;
    height: 1fr;
    scrollbar-size: 1 1;
}

.scan-review-page-row {
    width: 100%;
    height: 46;
    margin-bottom: 1;
}

.scan-review-page-card {
    width: 1fr;
    height: 46;
    margin-right: 1;
}

.scan-review-page-label {
    color: $text-muted;
}

.scan-review-page-image {
    width: 100%;
    height: 44;
    margin-bottom: 1;
}
